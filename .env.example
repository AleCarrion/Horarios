# Leave both empty to run in local-only mode (data kept in this device's localStorage).
NEXT_PUBLIC_SUPABASE_URL=
# The public anon / publishable key. If your host refuses a name containing "KEY", use NEXT_PUBLIC_SUPABASE_ANON instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Button "Continuar con Google" on the sign-in page: set to google once Google is enabled in Supabase
NEXT_PUBLIC_OAUTH_PROVIDERS=
